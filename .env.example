# Aqua AI - Environment configuration template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it is already in .gitignore).

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
# PostgreSQL connection string used by SQLAlchemy.
DATABASE_URL=postgresql://user:password@localhost:5432/aqua_ai

# ---------------------------------------------------------
# AI PROVIDER API KEYS
# ---------------------------------------------------------
# Text chat (sensor chat) uses the first available provider.
# Camera image analysis uses a vision-capable provider.

# Groq (default text + vision provider)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (optional text provider)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# DeepSeek (optional text provider)
# Get a key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------------------------------------------------------
# AI MODELS (optional - sensible defaults are used)
# ---------------------------------------------------------

# Text chat models
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
DEEPSEEK_MODEL=deepseek-chat

# Vision model used by the camera analysis feature.
# Must be a model that accepts image input.
# Verified against GET https://api.groq.com/openai/v1/models:
# qwen/qwen3.8-27b is the Groq-hosted model that accepts images.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Disables hidden reasoning for reasoning-type vision models
# (e.g. Groq qwen3) so the JSON answer is produced directly.
# Set it empty (GROQ_REASONING_EFFORT=) if your vision model
# does not support this parameter.
GROQ_REASONING_EFFORT=none

# ---------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------
# Bootstrap password for the single admin account (prakash).
# Set this to the desired password; the application hashes it
# automatically and refuses to start if the variable is missing.
# NEVER commit the real value to version control.
AUTH_BOOTSTRAP_PASSWORD=

# Session duration in hours (default: 24, max: 168)
AUTH_SESSION_HOURS=24

# Remember Me session duration in days (default: 30, max: 90)
REMEMBER_ME_DAYS=30

# Cookie security settings
# ENVIRONMENT=development or production
ENVIRONMENT=development
# Set to "true" to enable Secure cookie flag (requires HTTPS)
AUTH_COOKIE_SECURE=false
# SameSite cookie policy: strict, lax, or none
AUTH_COOKIE_SAMESITE=lax

# BCRYPT password hashing rounds (4-16, default: 12)
BCRYPT_ROUNDS=12

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
# Comma-separated list of additional allowed origins (optional)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
